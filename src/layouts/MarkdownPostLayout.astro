---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { camelize } from '@/utils/string'
import dayjs from 'dayjs'
import '@/styles/markdown.scss'

interface Props {
  frontmatter: {
    title: string
    author?: string
    description?: string
    pubDate?: string | Date
    tags?: string[]
    image?: {
      url: string
      alt?: string
    }
  }
  headings: { depth: number, slug: string, text: string }[]
}

const { frontmatter, headings } = Astro.props
const locale = Astro.currentLocale || 'ko'

// 본문이 제목과 같은 h1 으로 시작하면 헤더와 겹치므로 뺀다
const stripTags = (html: string) => html.replace(/<[^>]+>/g, '').trim()
const rawHtml = await Astro.slots.render('default')
const firstH1 = rawHtml.match(/^\s*<h1[^>]*>([\s\S]*?)<\/h1>/)
const isTitleDuplicated = firstH1 && stripTags(firstH1[1]) === frontmatter.title.trim()
const contentHtml = isTitleDuplicated ? rawHtml.slice(firstH1[0].length) : rawHtml

const tocHeadings = headings.filter(
  head => head.depth <= 3 && !(head.depth === 1 && head.text.trim() === frontmatter.title.trim()),
)
const minDepth = Math.min(...tocHeadings.map(head => head.depth))
---

<BaseLayout title={frontmatter.title}>
  <article class='post'>
    <header class='post-header'>
      {
        frontmatter.tags && frontmatter.tags.length > 0 && (
          <ul class='post-tags'>
            {frontmatter.tags.map(tag => (
              <li>{camelize(tag)}</li>
            ))}
          </ul>
        )
      }
      <h1 class='post-title'>{frontmatter.title}</h1>
      {
        frontmatter.description && (
          <p class='post-description'>{frontmatter.description}</p>
        )
      }
      {
        frontmatter.pubDate && (
          <time class='post-date'>
            {dayjs(frontmatter.pubDate).format('YYYY.MM.DD')}
          </time>
        )
      }
      {
        frontmatter.image && (
          <img
            class='post-cover'
            src={frontmatter.image.url}
            alt={frontmatter.image.alt}
          />
        )
      }
    </header>

    <div class='post-body'>
      <section class='markdown' set:html={contentHtml} />
      {
        tocHeadings.length > 0 && (
          <aside class='toc'>
            <p class='toc-label'>{locale === 'ko' ? '목차' : 'On this page'}</p>
            <ul>
              {tocHeadings.map(head => (
                <li style={`--toc-indent: ${head.depth - minDepth}`}>
                  <a href={`#${head.slug}`}>{head.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>

<style lang='scss'>
  .post-header {
    max-width: var(--max-width-content);
    padding: 72px 0 56px;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;

    li {
      padding: 4px 10px;
      border-radius: 999px;
      background: var(--accent-bg);
      color: var(--accent);
      font-size: rem(13px);
      font-weight: 600;
    }
  }

  .post-title {
    font-size: rem(40px);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.03em;
    color: var(--grey-900);
    word-break: keep-all;
  }

  .post-description {
    margin-top: 16px;
    font-size: rem(18px);
    line-height: 1.6;
    color: var(--grey-600);
  }

  .post-date {
    display: block;
    margin-top: 20px;
    font-size: rem(14px);
    color: var(--grey-500);
  }

  .post-cover {
    max-width: 100%;
    margin-top: 32px;
    border-radius: 16px;
  }

  .post-body {
    display: flex;
    align-items: flex-start;
    gap: 64px;
  }

  .markdown {
    flex: 1 1 auto;
    min-width: 0;
    max-width: var(--max-width-content);
  }

  .toc {
    flex: 0 0 240px;
    position: sticky;
    top: 92px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding-left: 16px;
    border-left: 1px solid var(--grey-200);

    &-label {
      margin-bottom: 12px;
      font-size: rem(12px);
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--grey-500);
    }

    li {
      padding-left: calc(var(--toc-indent) * 12px);
    }

    a {
      display: block;
      padding: 4px 0;
      font-size: rem(13px);
      line-height: 1.5;
      color: var(--grey-600);
      word-break: keep-all;
      transition: color 0.2s ease;

      &:hover {
        color: var(--accent);
      }
    }
  }

  @media screen and (max-width: 1024px) {
    .toc {
      display: none;
    }
  }

  @media screen and (max-width: 640px) {
    .post-header {
      padding: 40px 0 40px;
    }

    .post-title {
      font-size: rem(30px);
    }

    .post-description {
      font-size: rem(16px);
    }
  }
</style>
