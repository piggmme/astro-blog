---
import BaseLayout from '@/layouts/BaseLayout.astro'
import '@/styles/markdown.scss'

interface Props {
  frontmatter: {
    title?: string
  }
  headings?: any[]
}

const { frontmatter } = Astro.props
const title = frontmatter.title || 'About Me';
---

<BaseLayout title={title}>
  <section class='markdown me'>
    <slot />
  </section>
</BaseLayout>

<style lang='scss'>
  .me {
    max-width: var(--max-width-content);
    padding-top: 72px;

    :global(img) {
      max-width: 360px;
      width: 100%;
      margin: 32px 0;
      border-radius: 20px;
    }

    @media screen and (max-width: 640px) {
      padding-top: 40px;
    }
  }
</style>
