---
import { LinkedInLogoIcon, GitHubLogoIcon } from '@radix-ui/react-icons'

const { title } = Astro.props
const locale = Astro.currentLocale || 'ko'
const currentPath = Astro.url.pathname
const targetLocale = locale === 'ko' ? 'en' : 'ko'
const targetPath = currentPath.replace(/^\/(ko|en)/, `/${targetLocale}`);
---

<html lang={locale}>
  <head>
    <meta charset='utf-8' />
    <link rel='icon' href='/favicon.ico' />
    <meta name='viewport' content='width=device-width' />
    <meta name='generator' content={Astro.generator} />
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      rel='stylesheet'
      href='https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap'
    />
    <title>{title}</title>
  </head>
  <body>
    <header class='navbar'>
      <div class='navbar-inner'>
        <a class='navbar-home' href={`/${locale}`}>@dev_hee</a>
        <nav class='navbar-links'>
          <a class='lang-switcher' href={targetPath}>
            {targetLocale === 'ko' ? 'KO' : 'EN'}
          </a>
          <a class='navbar-text' href={`/${locale}/me`}>me</a>
          <a
            class='navbar-icon'
            href='https://github.com/piggmme'
            target='_blank'
            aria-label='GitHub'
          >
            <GitHubLogoIcon width={18} height={18} />
          </a>
          <a
            class='navbar-icon'
            href='https://www.linkedin.com/in/dev-hee'
            target='_blank'
            aria-label='LinkedIn'
          >
            <LinkedInLogoIcon width={18} height={18} />
          </a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class='footer'>
      <span>© dev_hee</span>
      <a href='mailto:kheeyaa888@gmail.com?subject=[After%20Reading%20Blog]'>
        kheeyaa888@gmail.com
      </a>
    </footer>
  </body>
</html>

<style lang='scss'>
  body {
    color: var(--font-black);
    background: #fff;
  }

  :global(::selection) {
    background: var(--pink-100);
    color: var(--grey-900);
  }

  .navbar {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--grey-100);

    &-inner {
      max-width: var(--max-width-container);
      margin: 0 auto;
      height: 60px;
      padding: 0 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    &-home {
      font-size: rem(18px);
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--grey-900);
    }

    &-links {
      display: flex;
      gap: 4px;
      align-items: center;
    }

    &-text,
    &-icon {
      display: flex;
      align-items: center;
      height: 36px;
      padding: 0 10px;
      border-radius: 8px;
      color: var(--grey-600);
      font-size: rem(15px);
      font-weight: 600;
      transition: background 0.2s ease, color 0.2s ease;

      &:hover {
        background: var(--grey-100);
        color: var(--grey-900);
      }
    }

    .lang-switcher {
      margin-right: 4px;
      padding: 3px 8px;
      border: 1px solid var(--grey-200);
      border-radius: 6px;
      color: var(--grey-600);
      font-size: rem(12px);
      font-weight: 600;
      letter-spacing: 0.02em;
      transition: border-color 0.2s ease, color 0.2s ease;

      &:hover {
        border-color: var(--grey-400);
        color: var(--grey-900);
      }
    }
  }

  main {
    max-width: var(--max-width-container);
    margin: 0 auto;
    padding: 0 24px;
    min-height: calc(100vh - 60px - 120px);
  }

  .footer {
    max-width: var(--max-width-container);
    margin: 120px auto 0;
    padding: 32px 24px 48px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    border-top: 1px solid var(--grey-100);
    color: var(--grey-500);
    font-size: rem(14px);

    a:hover {
      color: var(--grey-900);
    }
  }
</style>
