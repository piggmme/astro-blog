---
import Card from '@/components/Card.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { camelize } from '@/utils/string'
import '@/utils/dayjs'
import { dayFormat } from '@/utils/dayjs'
import { ChevronDownIcon } from '@radix-ui/react-icons'
import { getCollection, type CollectionEntry } from 'astro:content'
import { ui } from '@/i18n/ui'

export function getStaticPaths () {
  return [{ params: { locale: 'ko' } }, { params: { locale: 'en' } }]
}

const { locale } = Astro.params
const t = ui[locale as keyof typeof ui]

const allPosts = await getCollection('posts', ({ id }: { id: string }) => {
  return id.startsWith(`${locale}/`)
})

const POST_ITEM_MAX_COUNT = 2

const uniqueTags = [
  ...new Set(
    allPosts.map((post: CollectionEntry<'posts'>) => post.data.tags).flat(),
  ),
]
const tags = uniqueTags
  .map((tag) => {
    const filteredPosts = allPosts.filter(
      (post: CollectionEntry<'posts'>) => post.data.tags.includes(tag),
    )
    filteredPosts.sort(
      (a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => {
        const aDate = new Date(a.data.pubDate)
        const bDate = new Date(b.data.pubDate)
        return bDate.getTime() - aDate.getTime()
      },
    )

    const mappedPosts = filteredPosts.map((post, index) => {
      const pathSegments = post.id.split('/')
      const slug = pathSegments.slice(1).join('/').replace(/\.md$/, '')
      const url = `/${locale}/posts/${slug}`
      return {
        ...post,
        url,
        isHidden: index >= POST_ITEM_MAX_COUNT,
      }
    })

    return {
      tag,
      posts: mappedPosts,
    }
  })
  .sort((postA, postB) => {
    const findLatest = (posts: any[]) => {
      return posts.reduce((prev: any, current: any) => {
        const prevDate = new Date(prev.data.pubDate)
        const currentDate = new Date(current.data.pubDate)
        return prevDate.getTime() > currentDate.getTime()
          ? prev
          : current
      })
    }
    const latestPostA = findLatest(postA.posts)
    const latestPostB = findLatest(postB.posts)

    const aDate = new Date(latestPostA.data.pubDate)
    const bDate = new Date(latestPostB.data.pubDate)
    return bDate.getTime() - aDate.getTime()
  });
---

<BaseLayout title={t['home.title']}>
  <section class='home-header'>
    <h1>{t['home.title']}</h1>
    <p
      set:html={(t['home.description'] as string).replace('\n', '<br />')}
    />
  </section>

  {
    tags.map(({ tag, posts }) => (
      <section class='home-posts' data-tag={camelize(tag as string)}>
        <h2 class='tag-title'>
          {camelize(tag as string)}
          <span class='tag-count'>{posts.length}</span>
        </h2>
        <ul class='post-list'>
          {posts.map(post => (
            <li
              class:list={[
                'post-item',
                post.isHidden && 'post-item-hidden',
              ]}
            >
              <a href={post.url} class='post-link'>
                <div class='post-content'>
                  <h3 class='title'>{post.data.title}</h3>
                  {post.data.description && (
                    <p class='description'>{post.data.description}</p>
                  )}
                  <span class='subtitle'>
                    {dayFormat(post.data.pubDate, locale)}
                  </span>
                </div>
                {post.data.image?.url && (
                  <div class='post-image'>
                    <img
                      class='image'
                      src={post.data.image.url}
                      alt={post.data.image.alt}
                    />
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
        {posts.length > POST_ITEM_MAX_COUNT && (
          <button class='expand-button' data-target={camelize(tag)}>
            {t['home.more']}{' '}
            <ChevronDownIcon width={16} height={16} />
          </button>
        )}
      </section>
    ))
  }
</BaseLayout>

<style lang='scss'>
  .home-header {
    padding: 96px 0 72px;

    h1 {
      font-size: rem(56px);
      font-weight: 800;
      letter-spacing: -0.04em;
      line-height: 1.1;
      color: var(--grey-900);
    }

    p {
      margin-top: 16px;
      font-size: rem(18px);
      line-height: 1.6;
      color: var(--grey-600);
    }
  }

  .home-posts {
    max-width: 880px;
    margin-bottom: 64px;

    .tag-title {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
      font-size: rem(22px);
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--grey-900);
    }

    .tag-count {
      color: var(--grey-400);
      font-weight: 500;
    }

    .post-list {
      display: flex;
      flex-direction: column;
    }

    .post-item {
      border-bottom: 1px solid var(--grey-100);

      // 더보기 전에는 숨겨진 글 바로 앞 아이템이 화면상 마지막이다
      &:last-child,
      &:has(+ .post-item-hidden) {
        border-bottom: 0;
      }
    }

    .post-item-hidden {
      display: none;
    }

    .post-link {
      display: flex;
      align-items: center;
      gap: 24px;
      margin: 0 -16px;
      padding: 20px 16px;
      border-radius: 16px;
      transition: background 0.2s ease;

      &:hover {
        background: var(--grey-50);

        .title {
          color: var(--accent);
        }
      }

      @media screen and (max-width: 480px) {
        flex-direction: column-reverse;
        align-items: stretch;
        gap: 12px;
      }
    }

    .post-content {
      display: flex;
      flex-direction: column;
      gap: 6px;
      flex: 1;
      min-width: 0;
    }

    .title {
      font-size: rem(19px);
      font-weight: 700;
      line-height: 1.4;
      letter-spacing: -0.02em;
      color: var(--grey-900);
      word-break: keep-all;
      transition: color 0.2s ease;
    }

    .description {
      font-size: rem(15px);
      line-height: 1.6;
      color: var(--grey-600);
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    .subtitle {
      margin-top: 4px;
      color: var(--grey-500);
      font-size: rem(13px);
    }

    .post-image {
      flex: 0 0 160px;

      .image {
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        border-radius: 12px;
        background: var(--grey-100);
      }

      @media screen and (max-width: 480px) {
        flex-basis: auto;
      }
    }

    .expand-button {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      margin-top: 12px;
      padding: 4px 0;
      color: var(--grey-600);
      font-size: rem(14px);
      font-weight: 600;
      transition: color 0.2s ease;

      &:hover {
        color: var(--accent);
      }
    }

    .expand-button.hidden {
      display: none;
    }
  }

  @media screen and (max-width: 640px) {
    .home-header {
      padding: 56px 0 40px;

      h1 {
        font-size: rem(40px);
      }

      p {
        font-size: rem(16px);
      }
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const expandButtons = document.querySelectorAll('.expand-button')

  expandButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const section = button.closest('.home-posts')
      const hiddenItems
                = section?.querySelectorAll('.post-item-hidden')

      if (hiddenItems) {
        hiddenItems.forEach((item) => {
          item.classList.remove('post-item-hidden')
        })
        button.classList.add('hidden')
      }
    })
  })
})
</script>
